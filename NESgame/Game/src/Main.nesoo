class Game
{
    static void Start()
    {
        byte value = 4;

        if (value == 5)
        {
            Screen.SetTile(4, 7, 1);
        }
        else
        {
            Screen.SetTile(8, 7, 1);
        }
    }
}


class Palette
{
    static byte AddOne(byte value)
    {
        return value + 1;
    }
}