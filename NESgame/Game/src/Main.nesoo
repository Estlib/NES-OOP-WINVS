class Game
{
    static void Start()
    {
        byte a = 0x3C;
        byte b = 0x0F;

        byte value = (a & b) << 1;

        value = value - 2;

        if (value == 0x16)
        {
            Screen.SetTile(4, 7, 1);
        }
        else
        {
            Screen.SetTile(8, 7, 1);
        }
    }
}


class Palette
{
    static byte AddOne(byte value)
    {
        return value + 1;
    }
}