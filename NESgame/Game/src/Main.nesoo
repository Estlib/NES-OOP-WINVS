class Game
{
    static void Start()
    {
        // ================================================
        // WHILE + ELSE
        //
        // Draws x 2,3,4.
        // Natural completion then draws x 5.
        // ================================================

        byte i = 0;

        while (i < 3)
        {
            Screen.SetTile(
                i + 2,
                4,
                1
            );

            i = i + 1;
        }
        else
        {
            Screen.SetTile(
                5,
                4,
                1
            );
        }


        // ================================================
        // DO / WHILE
        //
        // false condition, but must execute once.
        // ================================================

        do
        {
            Screen.SetTile(
                2,
                6,
                1
            );
        }
        while (false);


        // ================================================
        // FOR + CONTINUE + BREAK + ELSE
        //
        // j=0 -> draw x2
        // j=1 -> continue
        // j=2 -> draw x4
        // j=3 -> break
        //
        // Because break occurred, ELSE MUST NOT run.
        // ================================================

        for (
            byte j = 0;
            j < 5;
            j = j + 1
        )
        {
            if (j == 1)
            {
                continue;
            }

            if (j == 3)
            {
                break;
            }

            Screen.SetTile(
                j + 2,
                8,
                1
            );
        }
        else
        {
            Screen.SetTile(
                10,
                8,
                1
            );
        }


        // ================================================
        // FOR + ELSE NATURAL COMPLETION
        //
        // Draw x2,x3 then ELSE draws x4.
        // ================================================

        for (
            byte k = 0;
            k < 2;
            k = k + 1
        )
        {
            Screen.SetTile(
                k + 2,
                10,
                1
            );
        }
        else
        {
            Screen.SetTile(
                4,
                10,
                1
            );
        }
    }
}


class Palette
{
    static byte AddOne(byte value)
    {
        return value + 1;
    }
}